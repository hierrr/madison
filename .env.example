HOST=127.0.0.1
PORT=8787
DB_PATH=data/madison.db
DASHBOARD_HOST=madison.example.com
API_HOST=madison-api.example.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ENROLL_SECRET=change-me-then-clear
TTL_STALE_MIN=15
DEVICE_ONLINE_MIN=10
ENDED_HIDE_HOURS=24
EVENT_RETENTION_DAYS=0
IP_ALLOWLIST=
TASK_SUMMARY=1
TASK_SUMMARY_MODEL=claude-haiku-4-5-20251001
TASK_SUMMARY_BIN=
CODEX_BIN=
REPORT=1
REPORT_MODEL=claude-sonnet-5
# Model for pre-compressing long sessions (cheaper than the report model is fine)
DIGEST_MODEL=
# Per-site timeouts (seconds) for hub LLM calls: summary / digest / report
LLM_TIMEOUT_SUMMARY=90
LLM_TIMEOUT_DIGEST=300
LLM_TIMEOUT_REPORT=900
# Working directory for hub LLM calls (must not be inside a git repository)
LLM_CWD=
REPORT_DAILY_CRON=0 * * * *
REPORT_WEEKLY_CRON=15 */4 * * *
REPORT_MONTHLY_CRON=45 */8 * * *
# 리포트에서 통째로 뺄 프로젝트(콤마 구분)
REPORT_EXCLUDE_PROJECTS=
# 프로젝트 → 리포트 최상위 서비스명(콤마 구분, proj=서비스). 없으면 프로젝트명 그대로
REPORT_SERVICE_MAP=
# 자기 프로젝트가 없는 서비스(다른 서비스 저장소·모노리포 안에서 작업되는 경우, 세미콜론 구분, 서비스=식별 단서).
# 리포트 프롬프트의 '알려진 서비스'에 단서와 함께 실려 해당 항목이 올바른 서비스 밑으로 들어간다
REPORT_KNOWN_SERVICES=
# Scratch directories whose service mapping is only a weak default (comma-separated)
REPORT_WEAK_PROJECTS=

# Claude/Codex subscription limits on the overview (hub collects them itself). USAGE=0 disables.
USAGE=1
USAGE_POLL_SEC=180
